---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found — Ahmad Bayrakdar" description="This page does not exist.">
  <div class="container notfound">
    <p class="code mono">404</p>
    <h1 class="display">Page not found</h1>
    <p class="lead">The page you're looking for has moved or never existed.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/">Back to home <Icon name="arrowRight" /></a>
      <a class="btn btn-secondary" href="/projects/">Browse projects</a>
    </div>
  </div>
</Base>
